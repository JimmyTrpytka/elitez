# Vzor nastavení. Zkopíruj do souboru .env.local a doplň hodnoty.
# .env.local se NIKDY neukládá do gitu.
#
# Hodnoty najdeš v Supabase: Project Settings → API Keys / Data API.

# Adresa projektu, např. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Veřejný klíč: "Publishable key" (sb_publishable_...), případně starší "anon" klíč.
# NIKDY sem nedávej "secret" / "service_role" klíč.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresa webu (pro odkazy v e-mailech). Lokálně http://localhost:3000,
# ve Vercelu https://elitez-cyan.vercel.app (nebo vlastní doména).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- E-maily (Milník 5) – TAJNÉ, jen v .env.local a ve Vercelu ----
# Tajný klíč Supabase (Project Settings → API Keys → Secret key, sb_secret_...).
# Slouží jen k odesílání fronty e-mailů na serveru. NIKDY s předponou NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Resend (resend.com → API Keys)
RESEND_API_KEY=
# Odesílatel. Bez ověřené domény jen: ELITEZ <onboarding@resend.dev> (posílá jen na tvůj e-mail)
EMAIL_FROM=ELITEZ <onboarding@resend.dev>
# Volitelně adresa pro odpovědi
EMAIL_REPLY_TO=
# Denní limit (bezplatný Resend = 100)
EMAIL_DAILY_LIMIT=100

# Tajný řetězec pro denní cron ve Vercelu (libovolný dlouhý náhodný text)
CRON_SECRET=

# ---- Provozovatel (stránka Ochrana osobních údajů) – veřejné údaje ----
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ID=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_EMAIL=
